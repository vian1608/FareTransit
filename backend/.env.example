# Server Configuration
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:3000

# ─── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

# ─── Email — Resend ───────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=FareTransit LLC <onboarding@resend.dev>

# ─── SerpAPI ─────────────────────────────────────────────────
SERPAPI_API_KEY=your_serpapi_api_key

# ─── Enterprise Rent-A-Car inventory via Parse.bot ───────────
# Keep PARSE_API_KEY server-side only.
PARSE_API_KEY=your_parse_api_key
PARSE_ENTERPRISE_BASE_URL=https://api.parse.bot/scraper/897a30e0-28fa-40f3-b343-38a2acbd144b
PARSE_API_SNAPSHOT_VERSION=6
CAR_QUOTE_TTL_MINUTES=15

# ─── NMI / Maverick e-commerce checkout ──────────────────────
# Public tokenization key is safe to expose through the checkout config endpoint.
# Private API key must remain server-side and must never be committed.
NMI_ENVIRONMENT=sandbox
NMI_PUBLIC_TOKENIZATION_KEY=your_nmi_public_tokenization_key
NMI_PRIVATE_API_KEY=your_nmi_private_api_key
# Optional override. Defaults to sandbox or production NMI REST API based on NMI_ENVIRONMENT.
# NMI_API_BASE_URL=https://sandbox.nmi.com/api/v5

# ─── FareTransit manual checkout settings ────────────────────
SECURE_PAYMENT_PUBLIC_LINK_HOURS=48
SECURE_PAYMENT_OTP_MINUTES=5
SECURE_PAYMENT_ACCESS_MINUTES=5

# ─── Admin ───────────────────────────────────────────────────
ADMIN_EMAIL=admin@faretransit.com
ADMIN_PASSWORD=your_admin_password

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d
