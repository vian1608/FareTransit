# Server Configuration
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:3000

# ─── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

# ─── Email — Resend ───────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=FareTransit LLC <onboarding@resend.dev>

# ─── NMI / Maverick Customer Vault ───────────────────────────
# PRIVATE key: server-side only. Never expose this in React or commit a real key.
NMI_ENVIRONMENT=sandbox
NMI_PRIVATE_API_KEY=your_nmi_private_api_key
# Override if Maverick provides a merchant-specific API endpoint.
NMI_API_BASE_URL=https://sandbox.nmi.com/api/v5

# ─── Stripe Payment Gateway ──────────────────────────────────
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_MOCK_MODE=true

# ─── PayPal Payment Gateway ──────────────────────────────────
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# ─── SerpAPI ─────────────────────────────────────────────────
SERPAPI_API_KEY=your_serpapi_api_key

# ─── Legacy secure-payment settings ──────────────────────────
# Retained only for older administrative authorization flows. New public checkout uses NMI Customer Vault.
SECURE_PAYMENT_PUBLIC_LINK_HOURS=48
SECURE_PAYMENT_OTP_MINUTES=5
SECURE_PAYMENT_ACCESS_MINUTES=5

# ─── Admin ───────────────────────────────────────────────────
ADMIN_EMAIL=admin@faretransit.com
ADMIN_PASSWORD=your_admin_password

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d
